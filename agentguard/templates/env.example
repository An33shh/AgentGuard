# =============================================================================
# AgentGuard — Environment Secrets
# Copy to .env and fill in your values. Never commit .env.
#
# In the git repo, non-secret defaults also come from .env.dev/.env.production
# — but this template is also what `agentguard init` bundles and ships for
# pip-installed users, who never have those two files (they live at the repo
# root, outside every packaged directory). This file must be fully
# self-contained and runnable on its own with just an API key filled in —
# it used to assume .env.dev's DATABASE_URL default was always present,
# which crashed `agentguard start` on startup for every pip-installed user
# with RuntimeError: DATABASE_URL is not set.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider (pick one)
# ---------------------------------------------------------------------------

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# AGENTGUARD_ANALYZER=openai
# OPENAI_API_KEY=sk-...
# AGENTGUARD_ANALYZER_MODEL=gpt-4o

# Groq
# AGENTGUARD_ANALYZER=groq
# GROQ_API_KEY=gsk_...
# AGENTGUARD_ANALYZER_MODEL=llama-3.1-70b-versatile

# Ollama (local, no key needed — run `ollama pull llama3.1` first)
# AGENTGUARD_ANALYZER=ollama
# AGENTGUARD_ANALYZER_MODEL=llama3.1

# Any OpenAI-compatible endpoint
# AGENTGUARD_ANALYZER=openai
# AGENTGUARD_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=your-key
# AGENTGUARD_ANALYZER_MODEL=your-model

# ---------------------------------------------------------------------------
# Database — SQLite by default (zero-setup, no Docker needed, data persists
# in ./agentguard.db). Switch to Postgres for production by commenting the
# SQLite line out and uncommenting the Postgres one below.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./agentguard.db

# Postgres (production, or local dev via `docker compose up -d postgres`):
# DATABASE_URL=postgresql+asyncpg://agentguard:agentguard@localhost:5747/agentguard

# ---------------------------------------------------------------------------
# API Authentication (production — leave unset in dev to disable auth)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
# AGENTGUARD_API_KEY=your-secret-api-key
# AGENTGUARD_JWT_SECRET=your-jwt-signing-secret
